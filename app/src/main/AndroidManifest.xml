<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for cdimage.ubuntu.com (rootfs download). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- SessionService keeps the terminal sessions alive in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Hardware bridges (Hardware screen > Bridges), asked for only when one is turned on. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional wake lock / Wi-Fi lock from the notification ("Acquire wake lock"). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- uburoot-vibrate. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Guards the uburoot-* command receiver. Signature level: only this app,
         the system and root (uid 0 passes every permission check) may send. -->
    <permission
        android:name="com.reinanbr.uburoot.permission.CMD"
        android:description="@string/permission_cmd_description"
        android:label="@string/permission_cmd_label"
        android:protectionLevel="signature" />

    <application
        android:name=".UbuRootApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UbuRoot">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles its own config changes so rotation, keyboard or theme
             changes never tear down the terminal view. -->
        <activity
            android:name=".terminal.TerminalActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.UbuRoot.Terminal"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ui.KernelActivity"
            android:exported="false"
            android:label="@string/kernel_title" />

        <activity
            android:name=".ui.HardwareActivity"
            android:exported="false"
            android:label="@string/hw_title" />

        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:label="@string/about_title" />

        <!-- "Open in UbuRoot": a session in the shared file's directory. Its own
             (empty) affinity: it never becomes the root of the terminal's task,
             whose root intent would then swallow the next share. -->
        <activity
            android:name=".bridge.ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/share_label"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- uburoot-notify/toast/vibrate/clip/open (am broadcast from the root
             helper inside Ubuntu). -->
        <receiver
            android:name=".bridge.CommandReceiver"
            android:exported="true"
            android:permission="com.reinanbr.uburoot.permission.CMD">
            <intent-filter>
                <action android:name="com.reinanbr.uburoot.CMD" />
            </intent-filter>
        </receiver>

        <!-- Files from uburoot-open, handed to viewers as content:// URIs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- A terminal emulator has no matching foreground service type: the
             shells are user-started, long-running processes (specialUse). -->
        <service
            android:name=".terminal.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-started terminal sessions (a chroot shell) running while the app is in the background." />
        </service>

        <!-- The hardware bridges: camera, microphone and location are what they serve;
             sensors and playback have no type of their own (specialUse). -->
        <service
            android:name=".hwbridge.BridgeService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|location|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Serves the phone's sensors and audio playback to the user's own Linux (chroot) programs while a bridge is turned on." />
        </service>
    </application>
</manifest>
