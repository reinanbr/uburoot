    <!-- Phase 5: start at boot -->
    <string name="settings_boot">Start at boot</string>
    <string name="settings_boot_start">Start Ubuntu at boot</string>
    <string name="settings_boot_hint">Mounts Ubuntu at boot and runs, as root, the executable scripts in /etc/uburoot-boot.d inside it, in name order (e.g. 10-sshd that runs /usr/sbin/sshd -p 8022). Scripts should start daemons in the background. Log: /data/local/uburoot/boot.log. Needs the UbuRoot module: install this APK as a module in Magisk, KernelSU or APatch.</string>
