<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for cdimage.ubuntu.com (rootfs download). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- SessionService keeps the terminal sessions alive in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional wake lock / Wi-Fi lock from the notification ("Acquire wake lock"). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".UbuRootApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UbuRoot">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles its own config changes so rotation, keyboard or theme
             changes never tear down the terminal view. -->
        <activity
            android:name=".terminal.TerminalActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.UbuRoot.Terminal"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- A terminal emulator has no matching foreground service type: the
             shells are user-started, long-running processes (specialUse). -->
        <service
            android:name=".terminal.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-started terminal sessions (a chroot shell) running while the app is in the background." />
        </service>
    </application>
</manifest>
