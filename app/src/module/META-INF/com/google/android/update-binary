#!/sbin/sh
# Recovery entry point (TWRP etc.). Only Magisk supports installing modules
# from recovery; KernelSU and APatch modules are not recovery-compatible.
# Hands over to Magisk's own module installer (install_module in
# /data/adb/magisk/util_functions.sh), as Magisk's module guide prescribes.
umask 022
ui_print() { echo "$1"; }
# Read by util_functions.sh.
# shellcheck disable=SC2034
OUTFD=$2
# shellcheck disable=SC2034
ZIPFILE=$3
mount /data 2>/dev/null
if [ ! -f /data/adb/magisk/util_functions.sh ]; then
    ui_print "! UbuRoot: flashing in recovery needs Magisk (v20.4+) installed."
    ui_print "! With KernelSU or APatch, install this file from the manager app,"
    ui_print "! or just install it as an APK."
    exit 1
fi
# shellcheck source=/dev/null
. /data/adb/magisk/util_functions.sh
install_module
exit 0
